{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://colligo.example/schemas/duvri-intake.schema.json",
  "title": "Colligo DUVRI client intake (local prototype)",
  "description": "Schema for the local questionnaire JSON export. It records declarations and attachment metadata only; it is not a DUVRI or a technical approval.",
  "type": "object",
  "required": [
    "schema",
    "documentType",
    "recordId",
    "createdAt",
    "prototypeStatus",
    "cloudSubmission",
    "aiGenerationStarted",
    "humanReviewRequired",
    "workflow",
    "job",
    "client",
    "site",
    "work",
    "contractors",
    "modules",
    "roofAccess",
    "coordination",
    "sourceChecklist",
    "documents",
    "documentAvailability",
    "aiDataProcessingConsent",
    "notes",
    "notices",
    "missingInformation"
  ],
  "properties": {
    "schema": {
      "const": "colligo-duvri-client-intake/0.1"
    },
    "documentType": {
      "const": "duvri"
    },
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "prototypeStatus": {
      "const": "local-intake-only"
    },
    "cloudSubmission": {
      "const": false
    },
    "aiGenerationStarted": {
      "const": false
    },
    "humanReviewRequired": {
      "const": true
    },
    "workflow": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent",
          "label",
          "status"
        ],
        "properties": {
          "agent": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "status": {
            "const": "not_connected"
          }
        },
        "additionalProperties": false
      }
    },
    "job": {
      "type": "object",
      "required": [
        "title",
        "documentType",
        "documentDate",
        "complexity",
        "startDate",
        "endDate"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "documentType": {
          "const": "duvri"
        },
        "documentDate": {
          "type": "string"
        },
        "complexity": {
          "type": "string"
        },
        "startDate": {
          "type": "string"
        },
        "endDate": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "client": {
      "type": "object",
      "required": [
        "legalName",
        "vatOrTaxId",
        "registeredAddress",
        "contactName",
        "contactPhone",
        "contactEmail",
        "siteContactName",
        "siteContactPhone"
      ],
      "properties": {
        "legalName": {
          "type": "string"
        },
        "vatOrTaxId": {
          "type": "string"
        },
        "registeredAddress": {
          "type": "string"
        },
        "contactName": {
          "type": "string"
        },
        "contactPhone": {
          "type": "string"
        },
        "contactEmail": {
          "type": "string"
        },
        "siteContactName": {
          "type": "string"
        },
        "siteContactPhone": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "required": [
        "address",
        "context",
        "accessNotes",
        "areaDescription",
        "vehicleRoutes",
        "materialStorageAreas",
        "workDaysHours",
        "otherWorkersPresence",
        "publicPresence",
        "systems",
        "restrictions"
      ],
      "properties": {
        "address": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "accessNotes": {
          "type": "string"
        },
        "areaDescription": {
          "type": "string"
        },
        "vehicleRoutes": {
          "type": "string"
        },
        "materialStorageAreas": {
          "type": "string"
        },
        "workDaysHours": {
          "type": "string"
        },
        "systems": {
          "type": "string"
        },
        "restrictions": {
          "type": "string"
        },
        "otherWorkersPresence": {
          "enum": [
            "unknown",
            "yes",
            "no"
          ]
        },
        "publicPresence": {
          "enum": [
            "unknown",
            "yes",
            "no"
          ]
        }
      },
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "required": [
        "description",
        "workSchedule",
        "overlappingActivities",
        "areaSegregation",
        "systemInterruptions",
        "deliveriesAndTraffic",
        "coordinationNotes"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "workSchedule": {
          "type": "string"
        },
        "overlappingActivities": {
          "type": "string"
        },
        "areaSegregation": {
          "type": "string"
        },
        "systemInterruptions": {
          "type": "string"
        },
        "deliveriesAndTraffic": {
          "type": "string"
        },
        "coordinationNotes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "contractors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index",
          "company",
          "role",
          "parentCompany",
          "vatOrTaxId",
          "contactName",
          "contactPhone",
          "contactEmail",
          "workerCount",
          "scope",
          "preposto",
          "equipment",
          "ppe"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "company": {
            "type": "string"
          },
          "role": {
            "enum": [
              "contractor",
              "subcontractor",
              "other"
            ]
          },
          "parentCompany": {
            "type": "string"
          },
          "vatOrTaxId": {
            "type": "string"
          },
          "contactName": {
            "type": "string"
          },
          "contactPhone": {
            "type": "string"
          },
          "contactEmail": {
            "type": "string"
          },
          "workerCount": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "scope": {
            "type": "string"
          },
          "preposto": {
            "type": "object",
            "required": [
              "name",
              "roleOrArea",
              "status"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "roleOrArea": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "confirmed",
                  "to_be_confirmed"
                ]
              }
            },
            "additionalProperties": false
          },
          "equipment": {
            "type": "string"
          },
          "ppe": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roofAccess": {
      "type": "object",
      "required": [
        "roofWork",
        "accessMethod",
        "landingPoint",
        "protections",
        "lowerArea",
        "rescuePlan"
      ],
      "properties": {
        "roofWork": {
          "enum": [
            "unknown",
            "yes",
            "no"
          ]
        },
        "accessMethod": {
          "type": "string"
        },
        "landingPoint": {
          "type": "string"
        },
        "protections": {
          "type": "string"
        },
        "lowerArea": {
          "type": "string"
        },
        "rescuePlan": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "coordination": {
      "type": "object",
      "required": [
        "assemblyPoint",
        "emergencyContacts",
        "emergencyPlanStatus",
        "emergencyRoutesAffected",
        "requiredPermits"
      ],
      "properties": {
        "assemblyPoint": {
          "type": "string"
        },
        "emergencyContacts": {
          "type": "string"
        },
        "emergencyPlanStatus": {
          "enum": [
            "unknown",
            "available",
            "to_acquire",
            "not_applicable"
          ]
        },
        "emergencyRoutesAffected": {
          "enum": [
            "unknown",
            "yes",
            "no"
          ]
        },
        "requiredPermits": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sourceChecklist": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/attachment"
        }
      ]
    },
    "documents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attachment"
      }
    },
    "documentAvailability": {
      "type": "object",
      "required": [
        "contratto-capitolato",
        "dvr-specifico",
        "cronoprogrammi",
        "planimetrie-layout",
        "mezzi-attrezzature",
        "procedure-operative",
        "emergenze",
        "sds",
        "permessi",
        "foto-sito"
      ],
      "properties": {
        "contratto-capitolato": {
          "enum": [
            "available",
            "to_acquire",
            "to_verify",
            "not_applicable"
          ]
        },
        "dvr-specifico": {
          "enum": [
            "available",
            "to_acquire",
            "to_verify",
            "not_applicable"
          ]
        },
        "cronoprogrammi": {
          "enum": [
            "available",
            "to_acquire",
            "to_verify",
            "not_applicable"
          ]
        },
        "planimetrie-layout": {
          "enum": [
            "available",
            "to_acquire",
            "to_verify",
            "not_applicable"
          ]
        },
        "mezzi-attrezzature": {
          "enum": [
            "available",
            "to_acquire",
            "to_verify",
            "not_applicable"
          ]
        },
        "procedure-operative": {
          "enum": [
            "available",
            "to_acquire",
            "to_verify",
            "not_applicable"
          ]
        },
        "emergenze": {
          "enum": [
            "available",
            "to_acquire",
            "to_verify",
            "not_applicable"
          ]
        },
        "sds": {
          "enum": [
            "available",
            "to_acquire",
            "to_verify",
            "not_applicable"
          ]
        },
        "permessi": {
          "enum": [
            "available",
            "to_acquire",
            "to_verify",
            "not_applicable"
          ]
        },
        "foto-sito": {
          "enum": [
            "available",
            "to_acquire",
            "to_verify",
            "not_applicable"
          ]
        }
      },
      "additionalProperties": false
    },
    "aiDataProcessingConsent": {
      "const": false
    },
    "notes": {
      "type": "string"
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missingInformation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "attachment": {
      "type": "object",
      "required": [
        "name",
        "size",
        "mimeType",
        "lastModified",
        "contentIncluded",
        "includedInLocalPackage"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "mimeType": {
          "type": "string"
        },
        "lastModified": {
          "type": "integer",
          "minimum": 0
        },
        "contentIncluded": {
          "const": false
        },
        "includedInLocalPackage": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  }
}
